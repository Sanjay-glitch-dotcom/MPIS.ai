# ==============================================================================
# MPIS.ai - Environment Configuration Template
# ==============================================================================

# Django Secret Key (Generate a secure random key in production)
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=*

# Database Engine ('sqlite3' or 'postgresql')
USE_SQLITE=True
DB_ENGINE=sqlite3

# PostgreSQL Database Configuration (if USE_SQLITE=False)
DB_NAME=mpis_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432

# Frontend Environment Variables (Frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api/
